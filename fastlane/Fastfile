opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Run unit tests"
  lane :unit_test do
    # Ensure we're on main thread for CI
    setup_ci
    
    # Get available devices and use the first iPhone
    available_devices = sh("xcrun simctl list devices available | grep -i 'iphone' | head -1 | cut -d '(' -f 1 | xargs").chomp
    
    if available_devices.empty?
      available_devices = ["iPhone 16 Pro"]
    else
      puts "Using available device: #{available_devices}"
      available_devices = [available_devices]
    end
    
    run_tests(
      scheme: "AIClassification",
      devices: available_devices,
      clean: true,
      output_directory: "./fastlane/test_output",
      output_types: "html,junit",
      output_files: "report.html,report.junit",
      buildlog_path: "./fastlane/build_logs",
      disable_concurrent_testing: true,
      reset_simulator: true,
      prelaunch_simulator: true,
      max_concurrent_simulators: 1,
      derived_data_path: "./DerivedData",
      xcargs: "-quiet",
      fail_build: true,
      deployment_target_version: "18.5"  # Match your app's deployment target
    )
  end

  # Lane for CI with specific device
  desc "Run tests for CI environment"
  lane :ci_test do
    unit_test
  end

  # Lane for local development
  desc "Run tests locally with visible simulator"
  lane :local_test do
    # Boot simulator first for visibility
    sh "xcrun simctl boot 'iPhone 16 Pro' || true"
    
    run_tests(
      scheme: "AIClassification",
      devices: ["iPhone 16 Pro"],
      clean: true,
      output_directory: "./fastlane/test_output",
      output_types: "html,junit",
      output_files: "report.html,report.junit",
      buildlog_path: "./fastlane/build_logs",
      reset_simulator: false,  # Don't reset to keep simulator visible
      prelaunch_simulator: false,
      deployment_target_version: "18.5"
    )
  end
end
